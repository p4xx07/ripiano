# Copy to .env on the Pi (cp gateway.env.example .env) and fill in. .env is not committed.

# Your domain without a service prefix. Services become ripiano.<DOMAIN>, jellyfin.<DOMAIN>, auth.<DOMAIN>.
DOMAIN=example.com
# Fixed LAN address of the Synology NAS (set a DHCP reservation in the router).
NAS_IP=192.168.1.10
# Host ports published on the NAS.
RIPIANO_PORT=8080
JELLYFIN_PORT=8096
# Let's Encrypt expiry warnings go here.
ACME_EMAIL=you@example.com
TZ=Europe/Rome
