# Local quickstart only. Set RIPIANO_DEBUG=0 and an HTTPS origin on the NAS.
RIPIANO_DEBUG=1
RIPIANO_SECRET_KEY=replace-with-at-least-32-random-characters
RIPIANO_SETUP_KEY=replace-with-at-least-24-random-characters
RIPIANO_DB_PASSWORD=replace-with-a-strong-database-password
RIPIANO_PUBLIC_ORIGIN=http://localhost:8080
RIPIANO_ALLOWED_HOSTS=localhost,127.0.0.1
RIPIANO_PORT=8080
RIPIANO_MEDIA_PATH=ripiano_media
RIPIANO_DB_PATH=ripiano_postgres
RIPIANO_BACKUP_PATH=ripiano_backup
RIPIANO_BACKUP_HOUR=2
RIPIANO_BACKUP_MINUTE=0
RIPIANO_BACKUP_RETENTION=7
# Optional Telegram input: set token and owner, start with --profile telegram.
RIPIANO_TELEGRAM_BOT_TOKEN=
RIPIANO_TELEGRAM_OWNER_USERNAME=
RIPIANO_TELEGRAM_ALLOWED_CHAT_IDS=
