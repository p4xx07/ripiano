# Example values for deploy/docker-compose.yaml. Put real values wherever your
# Compose tool reads them (e.g. an .env file); do not commit production secrets.
# No images are published from the current draft PR. Replace these image tags
# with the digest references printed by a successful tagged release workflow.
RIPIANO_API_IMAGE=ghcr.io/p4xx07/ripiano-api:replace-with-release
RIPIANO_WEB_IMAGE=ghcr.io/p4xx07/ripiano-web:replace-with-release
RIPIANO_DEBUG=0
RIPIANO_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
RIPIANO_SETUP_KEY=replace-with-a-unique-random-setup-key
RIPIANO_DB_PASSWORD=replace-with-a-unique-random-database-password
RIPIANO_PUBLIC_ORIGIN=https://ripiano.example.com
RIPIANO_ALLOWED_HOSTS=ripiano.example.com
RIPIANO_PORT=8080
RIPIANO_MEDIA_PATH=/srv/ripiano/media
RIPIANO_DB_PATH=/srv/ripiano/postgres
RIPIANO_BACKUP_PATH=/srv/ripiano/backups
RIPIANO_BACKUP_HOUR=2
RIPIANO_BACKUP_MINUTE=0
RIPIANO_BACKUP_RETENTION=7
RIPIANO_BROWSE_RETENTION=2
# Optional email intake. Leave the OAuth values empty to use IMAP app passwords only.
RIPIANO_MAIL_POLL_MINUTES=5
RIPIANO_GMAIL_OAUTH_CLIENT_ID=
RIPIANO_GMAIL_OAUTH_CLIENT_SECRET=
RIPIANO_OUTLOOK_OAUTH_CLIENT_ID=
RIPIANO_OUTLOOK_OAUTH_CLIENT_SECRET=
# Optional outgoing mail for workflow emails (starttls, ssl, or none).
RIPIANO_SMTP_HOST=
RIPIANO_SMTP_PORT=587
RIPIANO_SMTP_USER=
RIPIANO_SMTP_PASSWORD=
RIPIANO_SMTP_SECURITY=starttls
RIPIANO_SMTP_FROM=
# Let people email documents from the app (needs the SMTP settings above).
RIPIANO_DOCUMENT_EMAIL=0
# Optional semantic search (turn it on in Agents -> Search by meaning). Needs a database image with pgvector;
# pin its digest. For the server-side model, also start the "semantic" profile (embedder service).
# RIPIANO_DB_IMAGE=pgvector/pgvector:pg17
RIPIANO_EMBEDDER_THREADS=1
RIPIANO_EMBEDDER_MEMORY=1500m
RIPIANO_EMBEDDER_CPUS=1.0
# Host folder for folder sources (Sources -> Folder on the server). Create it first; Ripiano (UID 10001) needs
# read access, plus write access if a source moves or deletes imported files.
RIPIANO_SOURCES_PATH=/srv/ripiano/sources
# Consume folder: drop files here and Ripiano imports them for the archive owner, then removes them.
# Ripiano (UID 10001) needs read and write access. Leave unset to use a Docker volume.
RIPIANO_CONSUME_PATH=/srv/ripiano/consume

# Reverse proxy in front of Ripiano on another machine, space-separated IPs/CIDRs.
# Lets the sign-in throttle see each person's address. Leave empty when only a local reverse proxy is used.
RIPIANO_TRUSTED_PROXIES=
