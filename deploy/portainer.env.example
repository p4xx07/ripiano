# Example values for deploy/compose.portainer.yaml. Enter real values in
# Portainer's Environment variables section; do not commit production secrets.
# No images are published from the current draft PR. Replace these image tags
# with the digest references printed by a successful tagged release workflow.
RIPIANO_API_IMAGE=ghcr.io/p4xx07/ripiano-api:replace-with-release
RIPIANO_WEB_IMAGE=ghcr.io/p4xx07/ripiano-web:replace-with-release
RIPIANO_DEBUG=0
RIPIANO_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
RIPIANO_SETUP_KEY=replace-with-a-unique-random-setup-key
RIPIANO_DB_PASSWORD=replace-with-a-unique-random-database-password
RIPIANO_PUBLIC_ORIGIN=https://ripiano.example.com
RIPIANO_ALLOWED_HOSTS=ripiano.example.com
RIPIANO_PORT=8080
RIPIANO_MEDIA_PATH=/volume1/docker/ripiano/media
RIPIANO_DB_PATH=/volume1/docker/ripiano/postgres
RIPIANO_BACKUP_PATH=/volume1/ripiano-backups
RIPIANO_BACKUP_HOUR=2
RIPIANO_BACKUP_MINUTE=0
RIPIANO_BACKUP_RETENTION=7
